# AI Agent Brouwer - omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env* staat in .gitignore: commit nooit een ingevulde versie.

# --- Supabase (verplicht) --------------------------------------------------

# Project URL uit Supabase: Project Settings > Data API
# Alleen de kale project-URL, zonder /rest/v1 erachter.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Service role key uit Supabase: Project Settings > API Keys > service_role
# LET OP: deze sleutel omzeilt Row Level Security en mag uitsluitend server-side
# gebruikt worden. Nooit met NEXT_PUBLIC_ prefix, nooit in de browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Analyseprovider (optioneel) -------------------------------------------
#
# Zonder deze variabelen draait de applicatie op de ingebouwde testprovider:
# geen externe API, geen kosten. De hele keten werkt dan wel, maar de bevindingen
# zijn vaste testbevindingen.
#
# Zet AI_PROVIDER op "openai" om een echte analyse te doen. Dat is de enige manier
# waarop de applicatie een betaalde API aanroept.
# AI_PROVIDER=openai

# Alleen nodig wanneer AI_PROVIDER=openai.
# Sleutel uit https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optioneel. Leeg laten gebruikt gpt-5.6-terra.
# Beschikbaar: gpt-5.6-sol (flagship), gpt-5.6-terra (balans), gpt-5.6-luna (goedkoopst).
# OPENAI_MODEL=
